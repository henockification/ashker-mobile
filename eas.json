{
  "build": {
    "development": {
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true,
      "channel": "development",
      "environment": "development",
      "distribution": "internal",
      "developmentClient": true
    },

    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      },
      "channel": "development-simulator",
      "environment": "development"
    },

    "preview": {
      "channel": "preview",
      "environment": "preview",
      "distribution": "internal"
    },

    "production": {
      "channel": "production",
      "environment": "production"
    }
  },

  "cli": {
    "appVersionSource": "remote",
    "version": ">=16.32.0"
  }
}
