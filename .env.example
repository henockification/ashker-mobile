# Backend API (used by the app for data — not the Metro bundler URL)
EXPO_PUBLIC_API_URL=https://api.ashker.events

# Tenant origin — API resolves tenant from this (e.g. https://eternal-media.ashker.events)
EXPO_PUBLIC_TENANT_ORIGIN=https://eternal-media.ashker.events

# Optional: dev | stage | prod (affects app display name suffix)
# EXPO_PUBLIC_APP_VARIANT=dev

# Optional fallback when a business has no category for media uploads
# EXPO_PUBLIC_DEFAULT_MEDIA_CATEGORY_ID=
